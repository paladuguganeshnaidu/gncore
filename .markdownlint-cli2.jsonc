{
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "output/**",
    "archive/**",
    // Immutable experimental inputs and original model answers are evidence,
    // not authored documentation. Keep their original bytes unchanged.
    "web-results/**/first-candidate-guides/**",
    "web-results/**/runs/**",
    "web-results/ide-evidence/*-response.md",
    ".venv/**",
    ".work/**",
    ".agents/**",
    "dist/**",
    "src/gncore/skills/frontend_data/**",
    "src/gncore/skills/backend_data/**",
    "src/gncore/skills/unified_data/**"
  ]
}
